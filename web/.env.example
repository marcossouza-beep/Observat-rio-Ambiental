# Banco Postgres (Supabase em produção: use a "connection string" do pooler, modo transação)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/observatorio
# Segredo do Payload (32+ caracteres aleatórios; gere com: openssl rand -hex 32)
PAYLOAD_SECRET=
# Segredo das rotas /api/cron/* (chamadas pelos agendamentos do GitHub Actions)
CRON_SECRET=
# Endereço público do site (sem barra no fim)
SITE_URL=http://localhost:3000
# INLABS (Diário Oficial da União) — cadastro gratuito em inlabs.in.gov.br
INLABS_EMAIL=
INLABS_SENHA=
