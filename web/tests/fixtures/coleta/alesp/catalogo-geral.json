-\r\n.dropdown-menu {\r\n\tmargin-top: 0px !important;\r\n\tpadding-top: 0px !important;\r\n }\r\n-->\r\n</style>\r\n\r\n<div class=\"navbar navbar-fixed-top\">\r\n\t<div class=\"navbar-inner\">\r\n\t\t<div class=\"container-fluid\">\r\n\t\t\t<a class=\"btn btn-navbar\" data-toggle=\"collapse\"\r\n\t\t\t\tdata-target=\".nav-collapse\"> <span class=\"icon-bar\"></span> <span\r\n\t\t\t\tclass=\"icon-bar\"></span> <span class=\"icon-bar\"></span>\r\n\t\t\t</a> <h1><img class=\"logo\" src=\"https://www.al.sp.gov.br/_img/brasao_cabecalho.png\" /> Portal dos Dados Abertos da Alesp</h1> <br /><br />\r\n\r\n\r\n\t\t\t<div class=\"nav-collapse collapse\">\r\n\t\t\t\t<ul class=\"nav navbar-nav\">\r\n\t\t\t\t\t<li><a href=\"/dados-abertos/;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Home</a></li>\r\n\t\t\t\t\t<li class=\"dropdown\"><a class=\"dropdown-togle\"\r\n\t\t\t\t\t\tdata-toggle=\"dropdown\" href=\"/dados-abertos/sobre;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Sobre o projeto <b\r\n\t\t\t\t\t\t\tclass=\"caret\"></b></a>\r\n\t\t\t\t\t\t<ul class=\"dropdown-menu\">\r\n\t\t\t\t\t\t\t<li><a href=\"/dados-abertos/sobre;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Dados Abertos Alesp</a></li>\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<li><a href=\"/dados-abertos/lai;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Lei de Acesso à\r\n\t\t\t\t\t\t\t\t\tInformação</a></li>\r\n\t\t\t\t\t\t\t<li><a href=\"/dados-abertos/dadosabertos;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Dados\r\n\t\t\t\t\t\t\t\t\tGovernamentais Abertos</a></li>\r\n\t\t\t\t\t\t\t<li><a href=\"/dados-abertos/planejamento;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Planejamento</a></li>\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</ul></li>\r\n\t\t\t\t\t<li class=\"dropdown\"><a class=\"dropdown-togle\"\r\n\t\t\t\t\t\tdata-toggle=\"dropdown\" href=\"/dados-abertos/catalogo;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Catálogo de dados <b\r\n\t\t\t\t\t\t\tclass=\"caret\"></b></a>\r\n\t\t\t\t\t\t<ul class=\"dropdown-menu\">\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t<li><a href=\"/dados-abertos/grupo/1;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Processo Legislativo</a></li>\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t<li><a href=\"/dados-abertos/grupo/2;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Deputados Estaduais</a></li>\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t<li><a href=\"/dados-abertos/grupo/21;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Administração</a></li>\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t<li><a href=\"/dados-abertos/grupo/41;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Legislação</a></li>\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t<li><a href=\"/dados-abertos/grupo/81;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Agenda</a></li>\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</ul></li>\r\n\t\t\t\t\t<li><a href=\"/dados-abertos/perguntas;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Perguntas\r\n\t\t\t\t\t\t\tfrequentes</a></li>\r\n\t\t\t\t\t<li><a href=\"/dados-abertos/contato;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\">Contato</a></li>\r\n\t\t\t\t</ul>\r\n\t\t\t</div>\r\n\r\n\r\n\t\t\t<!--/.nav-collapse -->\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n\r\n\t<div class=\"container-fluid\">\r\n\r\n\t\t<h2 class=\"catalogo\">Catálogo</h2>\r\n\r\nEsta API suporta o modelo Representational State Transfer (REST) para acessar recursos através de um conjunto fixo de operações. Os seguintes recursos estão disponíveis através do modelo RESTful:<br/><br/>\r\n\r\n<table class=\"table\">\r\n\t<thead>\r\n\t\t<tr>\r\n\t\t\t<th>Nome</th>\r\n\t\t\t<th>Descrição</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tr>\r\n\t\t<td>\r\n\t\t\t<a href=\"/api/deputado\">/deputado/{partido}</a>\t\t\r\n\t\t</td>\r\n\t\t<td>\r\n\t\t\tServiço de acesso aos dados de deputados estaduais como, por exemplo, telefone de contato do gabinete, áreas de atuação, bases eleitorais, etc.\r\n\t\t</td>\r\n\t</tr>\t\r\n\t<tr>\r\n\t\t<td>\r\n\t\t\t<a href=\"/api/deputadoPresenca\">/deputadoPresenca/{deputado}</a>\t\t\r\n\t\t</td>\r\n\t\t<td>\r\n\t\t\tServiço de acesso aos dados de presença dos deputados estaduais em plenário.\r\n\t\t</td>\r\n\t</tr>\r\n\t<tr>\r\n\t\t<td>\r\n\t\t\t<a href=\"/api/despesa\">/despesa/{ano}/{mes}</a>\t\t\r\n\t\t</td>\r\n\t\t<td>\r\n\t\t\tServiço de acesso aos dados relativos às despesas realizadas com a utilização da verba de gabinete\r\n\t\t</td>\r\n\t</tr>\r\n\t\t<tr>\r\n\t\t<td>\r\n\t\t\t<a href=\"/api/propositura\">/propositura</a>\t\t\r\n\t\t</td>\r\n\t\t<td>\r\n\t\t\tProposituras de projetos de lei\r\n\t\t</td>\r\n\t</tr>\r\n</table>\r\n\r\n\t\t<hr>\r\n\r\n\t\t<footer>\r\n\t<em>Assembleia Legislativa do Estado de S&atilde;o Paulo</em>\r\n</footer>\r\n\r\n\t</div>\r\n\t<!-- /container -->\r\n\r\n\t<script src=\"/dados-abertos/assets/js/vendor/bootstrap.min.js;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\"></script>\r\n\r\n\t<script src=\"/dados-abertos/assets/js/main.js;jsessionid=56AC689DA4B80D3400CF2F3DBDA4F31B\"></script>\r\n\r\n\t<script>\r\n\t\t/*\r\n\t\t    var _gaq=[['_setAccount','UA-XXXXX-X'],['_trackPageview']];\r\n\t\t    (function(d,t){var g=d.createElement(t),s=d.getElementsByTagName(t)[0];\r\n\t\t    g.src=('https:'==location.protocol?'//ssl':'//www')+'.google-analytics.com/ga.js';\r\n\t\t    s.parentNode.insertBefore(g,s)}(document,'script'));\r\n\t\t */\r\n\t</script>\r\n</body>\r\n</html>\r\n"
