er-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1 bg-white\"><i class=\"text-primary lh-base fs-4 bx bxl-facebook\"></i></a>\n                            <a href=\"https://www.threads.net/@assembleiademinas\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1 bg-white\"><i class=\"text-primary lh-base fs-5 bi bi-threads\"></i></a>\n                        </div>\n          \t\t\t        <a href=\"https://www.almg.gov.br\" class=\" d-none d-xl-block d-xxl-block ps-4\"><img alt=\"Logomarca ALMG\" fetchpriority=\"high\" src=\"https://www.almg.gov.br/system/modules/br.gov.almg.site.commons/resources/imagens/logo-almg-white.svg\" style=\"height: 50px; width: auto;\"></a>\n        \t\t\t</div>\n        \t\t\t<div class=\"col-12 d-block d-lg-none text-center\">\n        \t\t\t\t<hr class=\"my-3 m-0\">\n        \t\t\t\t<ul class=\"nav flex-column flex-lg-column mb-0 lh-1\">\n        \t\t\t\t\t<li class=\"nav-item small\"><a class=\"nav-link link-hover-underline pb-0 px-0\"\n        \t\t\t\t\thref=\"/portal-da-almg/termos-de-uso-e-politica-de-privacidade/\">Termos de Uso e Política de Privacidade</a></li>\n        \t\t\t\t</ul>\n        \t\t\t</div>\n                    <div class=\"col-12 text-center text-light small \">\n                        <p>Versão: 2.4. </p>\n                    </div>\n        \t\t</div>\n        \t</div>\n        </div>\n        </footer>\n        </div>\n        <script>\n            // Function to toggle dropdown\n            function toggleDropdown(dropdown) {\n                const dropdownMenu = dropdown.querySelector('.dropdown-menu');\n                dropdownMenu.classList.toggle('show');\n            }\n\n            // Close dropdowns when clicking outside\n            document.addEventListener('click', function(event) {\n                const dropdowns = document.querySelectorAll('.dropdown');\n                dropdowns.forEach(function(dropdown) {\n                    if (!dropdown.contains(event.target)) {\n                        const dd = dropdown.querySelector('.dropdown-menu');\n                        if (dd){\n                            dd.classList.remove('show');\n                        }\n                    }\n                });\n            });\n\n            // Prevent dropdown from closing when clicking inside it\n            document.addEventListener('click', function(event) {\n                if (event.target.matches('.dropdown-menu') || event.target.closest('.dropdown-menu')) {\n                    event.stopPropagation();\n                }\n            });\n\n            // Add click event listeners to dropdown toggles\n            document.addEventListener('DOMContentLoaded', function() {\n                const dropdownToggles = document.querySelectorAll('.dropdown-toggle');\n                dropdownToggles.forEach(function(toggle) {\n                    toggle.addEventListener('click', function(event) {\n                        event.preventDefault();\n                        const dropdown = this.closest('.dropdown');\n                        toggleDropdown(dropdown);\n                    });\n                });\n            });\n        </script>\n        <script>\n                 function getCurrentServerURL() {\n                   // Get the current protocol (http or https)\n                   const protocol = window.location.protocol;\n\n                   // Get the hostname (server name)\n                   const hostname = window.location.hostname;\n\n                   // Get the port number (if applicable)\n                   const port = window.location.port;\n\n                   // Construct the URL string\n                   let url = protocol + '//' + hostname;\n\n                   // Append the port if it's non-standard (not 80 for http or 443 for https)\n                   if (port && port !== '80' && port !== '443') {\n                     url += ':' + port;\n                   }\n\n                   return url + '/';\n                 }\n\n                    document.addEventListener('DOMContentLoaded', function() {\n                        // Select all anchor tags\n                        const anchors = document.getElementsByTagName('a');\n\n                        // Convert to array and filter for relevant hrefs\n                        const relevantAnchors = Array.from(anchors).filter(anchor =>\n                            anchor.href.startsWith('http://dados-abertos/')\n                        );\n\n                        // Remove the prefix from relevant hrefs\n                        relevantAnchors.forEach(anchor => {\n                            anchor.href = anchor.href.replace('http://dados-abertos/', getCurrentServerURL());\n                        });\n                    });\n             </script>\n        <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js\"></script>\n    </body>\n</html>\n"
