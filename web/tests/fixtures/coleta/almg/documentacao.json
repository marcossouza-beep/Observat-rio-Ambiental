  "corpo": {
    "html": "\n\n\n<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">\n<html lang=\"pt-BR\">\n    <head>\n        <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n        <meta name=\"Author\" content=\"ALMG\">\n        <title>Dados Abertos - ALMG </title>\n\n        <!-- <link type=\"text/css\" rel=\"stylesheet\" href=\"/public/site.css\">-->\n        <link type=\"text/css\" rel=\"stylesheet\" href=\"https://www.almg.gov.br/system/modules/br.gov.almg.site.integracao/templates/dados-abertos/layout/site.css\">\n        <link type=\"image/x-icon\" rel='shortcut icon' href='http://www.almg.gov.br/opencms/opencms/system/modules/br.gov.almg.internet.apresentacao/resources/img/ajuda/ico_almg.ico'>\n        <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css\">\n\n        <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n        <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n        <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@200;300;400;500;600;700&family=Source+Serif+Pro:ital@0;1&display=swap\" rel=\"stylesheet\">\n\n        <link href=\"https://www.almg.gov.br/export/system/modules/br.gov.almg.portal/resources/css/theme.min.css\" rel=\"stylesheet\">\n        <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>\n        <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">\n        <link rel=\"stylesheet\" type=\"text/css\" media=\"screen\" href=\"https://www.almg.gov.br/system/modules/br.gov.almg.portal/resources/package/mobiscroll.custom/almg.css\">\n        <link rel='shortcut icon' href='/favicon.ico' type='image/x-icon' />\n    </head>\n    <body>\n        <div class=\"container-fluid m-0 p-0\">\n        <header class=\"d-xl-block\">\n            <nav class=\"navbar navbar-expand-xl navbar-primary bg-gray-700\">\n                <div class=\"container py-2 position-relative d-sm-block d-xl-none d-xxl-none\">\n                     <a href=\"https://www.almg.gov.br\" class=\"m-0 p-0 me-5 d-flex justify-content-center\">\n                        <img alt=\"Logomarca ALMG\" fetchpriority=\"high\" decoding=\"async\"\n                            data-nimg=\"fill\" src=\"https://www.almg.gov.br/system/modules/br.gov.almg.site.commons/resources/imagens/logo-almg-white.svg\"\n                            style=\"height: 48px; width: auto\">\n                     </a>\n                </div>\n                <div class=\"container py-2 position-relative d-none d-xl-block d-xxl-block\">\n            \t\t\t<div class=\"d-flex justify-content-center\">\n            \t\t\t     <a href=\"https://www.almg.gov.br\" class=\"m-0 p-0 me-5\">\n                                <img alt=\"Logomarca ALMG\" fetchpriority=\"high\" decoding=\"async\"\n                                    data-nimg=\"fill\" src=\"https://www.almg.gov.br/system/modules/br.gov.almg.site.commons/resources/imagens/logo-almg-white.svg\"\n                                    style=\"height: 48px; width: auto\">\n                             </a>\n            \t\t\t\t<!-- Subsites -->\n            \t\t\t\t<div class=\"dropdown me-3 mt-1\"><button id=\"sitesAlmg\" class=\"btn btn-secondary btn-sm text-uppercase dropdown-toggle\" type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\"> <em class=\"bi bi-box-arrow-up-right fs-6 me-2 lh-1\"> </em>Sites da ALMG <em class=\"bx bx-chevron-down fs-6 ms-1\"> </em> </button>\n<div id=\"dropDownSites\" class=\"dropdown-menu dropdown border-1 border-gray-200 mt-1\" aria-labelledby=\"sitesAlmg\"><a class=\"dropdown-item fw-semibold lh-sm py-2 border-bottom border-gray-150 \" href=\"https://www.almg.gov.br/sites-da-almg/Eleicoes-em-Minas-Gerais\">Eleições em Minas Gerais</a> <a class=\"dropdown-item fw-semibold lh-sm py-2 border-bottom border-gray-150 \" href=\"https://www.almg.gov.br/sites-da-almg/Portal-de-Politicas-Publicas\">Políticas Públicas ao Seu Alcance</a> <a class=\"dropdown-item fw-semibold lh-sm py-2 border-bottom border-gray-150 \" href=\"https://www.almg.gov.br/sites-da-almg/EAD-ALMG\">EaD Escola do Legislativo</a> <a class=\"dropdown-item fw-semibold lh-sm py-2 border-bottom border-gray-150 \" href=\"https://www.almg.gov.br/sites-da-almg/Acervo-Arquivistico\">Acervo Arquivístico</a> <a class=\"dropdown-item fw-semibold lh-sm py-2 border-bottom border-gray-150 \" href=\"https://www.almg.gov.br/sites-da-almg/Biblioteca-Digital\">Biblioteca Digital</a> <a class=\"dropdown-item fw-semibold lh-sm py-2 border-bottom border-gray-150 \" href=\"https://www.almg.gov.br/sites-da-almg/Acervo-da-Biblioteca\">Acervo da Biblioteca</a> <a class=\"dropdown-item fw-semibold lh-sm py-2 \" href=\"https://www.almg.gov.br/sites-da-almg/Dados-Abertos\">Dados Abertos</a></div>\n</div>\n            \t\t\t    <a href=\"https://www.almg.gov.br/apps/fale-com\" class=\"btn btn-primary btn-sm text-uppercase me-3 mt-1\"  style=\"height:37.5156px\">\n                        \t    <i class=\"bi bi-chat-fill fs-6 me-2 lh-1\"></i>Fale com a ALMG\n                        \t</a>\n\n            \t\t\t\t<!-- Redes -->\n            \t\t\t\t<div class=\"me-10 ms-10 d-flex flex-wrap align-items-center h-auto\">\n            \t\t\t\t\t<a href=\"http://www.youtube.com/assembleiamg/\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1\" style=\"background:#FF0000;\"><i class=\"text-white lh-base fs-4 bx bxl-youtube\"></i></a>\n            \t\t\t\t\t<a href=\"https://instagram.com/assembleiademinas/\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1\" style=\"background:#E1306C;\"><i class=\"text-white lh-base fs-4 bx bxl-instagram\"></i></a>\n            \t\t\t\t\t<a href=\"https://www.tiktok.com/@assembleiademinas\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1 bg-black\"><i class=\"text-white lh-base fs-5 bi bi-tiktok\"></i></a>\n            \t\t\t\t\t<a href=\"https://twitter.com/assembleiamg/\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1\" style=\"background:#000000;\"><i class=\"text-white lh-base fs-6 bi bi-twitter-x\"></i></a>\n            \t\t\t\t\t<a href=\"https://www.facebook.com/assembleiademinas\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1\" style=\"background:#4267B2;\"><i class=\"text-white lh-base fs-4 bx bxl-facebook\"></i></a>\n            \t\t\t\t\t<a href=\"https://www.threads.net/@assembleiademinas\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1\" style=\"background: #000000\"><i class=\"text-white lh-base fs-5 bi bi-threads\"></i></a>\n            \t\t\t\t</div>\n            \t\t\t</div>\n            \t\t</div>\n            </nav>\n            <div class=\"container-fluid api-menu-bar m-0 p-0\">\n                <div class=\"container\">\n                    <div class=\"row\">\n                        <div class=\"col-12\">\n                            <nav class=\"navbar navbar-expand-md navbar-light\">\n                              <div class=\"container-fluid p-0\">\n                                <div class=\"collapse navbar-collapse\">\n                                  <ul class=\"navbar-nav me-auto mb-2 mb-lg-0\">\n                                    <li class=\"nav-item px-3 text-center border-end\">\n                                      <a class=\"nav-link\" href=\"/documentacao/index\" data-test=\"menu\">Sobre</a>\n                                    </li>\n                                    <li class=\"nav-item px-3 text-center border-end\">\n                                      <a class=\"nav-link\" href=\"/api/ajuda/swagger/view/lastest#/\" data-test=\"menu\">Documentação da API</a>\n                                    </li>\n                                    <li class=\"nav-item px-3 text-center border-end\">\n                                      <a class=\"nav-link\" href=\"/documentacao/arquivos\" data-test=\"menu\">Arquivos</a>\n                                    </li>\n                                    <li class=\"nav-item px-3 text-center border-end\">\n                                      <a class=\"nav-link\" href=\"/documentacao/paginas/historico-de-versoes\" data-test=\"menu\">Histórico de versões</a>\n                                    </li>\n                                   </ul>\n                                </div>\n                              </div>\n\n                              <div class=\"text-end me-2 w-50\">\n                                  <form action=\"/busca\" method=\"get\" id=\"busca\">\n                                      <div class=\"input-group input-group-sm my-2\">\n                                           <input type=\"text\" class=\" form-control form-control-sm\" maxlength=\"50\" name=\"q\" value=\"\"\" placeholder=\"Buscar na documentação da API\"/>\n                                           <i class=\"bi bi-search pt-1 px-2 bg-white\" role=\"button\" onclick=\"document.getElementById('busca').submit()\"></i>\n                                      </div>\n                                  </form>\n                              </div>\n                            </nav>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <div class=\"container-fluid  api-bread-crumb\">\n            <div class=\"container\">\n                <nav aria-label=\"breadcrumb\" class=\"ms-3\">\n                  <ol class=\"breadcrumb\">\n\n                  </ol>\n                </nav>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <main>\n                    <div>\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-lg-9 col-md-12\">\n                    <img src=\"https://integracao.almg.gov.br:443/export/sites/integracao/dados-abertos/.img/banner_dados_abertos.png\" style=\"width: 100%; height: auto\" class=\"mb-5\"/>\n                    <div class=\"fs-6\"><h1>Sobre</h1>\n<p>A API de Dados Abertos da Assembleia Legislativa de Minas Gerais é uma <strong>interface de acesso livre</strong> que permite a reutilização, em <strong>aplicações digitais</strong>, de informações publicadas no <a href=\"https://www.almg.gov.br/\" title=\"Acessar Portal da ALMG\">Portal da ALMG</a>. Em geral, essas aplicações são desenvolvidas por entidades da sociedade civil, &nbsp;em busca de cruzamentos de dados para análises detalhadas sobre a instituição avaliada.</p>\n<p>A API da ALMG oferece dados estruturados, facilitando a criação de aplicações e a <strong>análise de informações </strong>relacionadas aos parlamentares, ao processo legislativo e ao orçamento da instituição.&nbsp;</p>\n<h3><strong>Número de requisições&nbsp;</strong></h3>\n<p>As requisições ao serviço de Dados Abertos são limitadas para evitar sobrecarga no sistema. Elas devem seguir as seguintes recomendações:</p>\n<ul>\n<li><strong>Requisições simultâneas:</strong> somente podem ser requisitadas, ao mesmo tempo, duas informações. Caso este limite seja extrapolado será exibida mensagem de acesso negado</li>\n<li><strong>Intervalo entre requisições:</strong> o intervalo de término de uma requisição e início de outra deve ser de, no mínimo, um segundo</li>\n</ul>\n<p>O acesso ao serviço poderá ser bloqueado sem aviso prévio no caso do não cumprimento das recomendações citadas acima.</p>\n<h3>Sobre a API</h3>\n<p>Ao usar a API disponível neste site, o usuário expressa sua concordância com as seguintes condições:</p>\n<ul>\n<li>A Assembleia se reserva o direito de modificar, suspender ou descontinuar qualquer aspecto da API disponibilizada, a seu exclusivo critério, sem responsabilidade por eventuais intercorrências geradas dessas implementações</li>\n<li>A Assembleia não presta suporte ao usuário, salvo em caso excepcionais, a seu exclusivo critério e podendo interrompê-lo a qualquer momento, sem aviso prévio</li>\n<li>O usuário dos Dados Abertos da Assembleia se responsabiliza integralmente pelo uso que deles fizer</li>\n<li>A Assembleia se reserva o direito de atualizar e alterar essas regras a qualquer tempo</li>\n<li>O usuário pode reportar erros técnicos e dificuldades pelo Fale com a Assembleia</li>\n</ul>\n<h3>Sobre os arquivos CSV</h3>\n<p>Alguns arquivos CSV originados dos sistemas internos da Assembleia estão disponíveis.</p>\n<h3>Termos de uso</h3>\n<p>Além das condições já descritas, os <a href=\"https://www.almg.gov.br/portal-da-almg/termos-de-uso-e-politica-de-privacidade/\" title=\"Termos de Uso e Política de Privacidade do Portal ALMG\">Termos de Uso e Política de Privacidade</a> do Portal ALMG se aplicam a este serviço.&nbsp;&nbsp;</p>\n<h3>Mais informações</h3>\n<ul>\n<li><a href=\"https://www.almg.gov.br/transparencia/prestacao-de-contas/inicial/\" title=\"Prestação de Contas da ALMG\">Prestação de Contas da ALMG</a></li>\n<li><a href=\"https://www.almg.gov.br/apps/fale-com/assembleia\" title=\"Fale com a Assembleia\">Fale com a Assembleia</a></li>\n</ul></div>\n            </div>\n            <div class=\"col-lg-3 fs-6 col-md-12 border-start api-avisos\">\n                <div class=\"h3 m-0 p-0 mb-1 \">Avisos</div>\n                    <dl>\n                            <dt class=\"text-info\">Novos arquivos CSV e endpoints para contratações (licitações), contratos, convênios e atas de registro de preço.</dt>\n                        <dd class=\"small pb-3 mb-2\"><p>Continuando a publicação de dados da ALMG, foram disponibilizados novos arquivos CSV e <em>endpoints </em>para contratações (licitações), contratos, convênios e atas de registro de preço. Os dados são provenientes de sistemas internos da ALMG, dados do Portal de Compras de Minas Gerais e do Portal Nacional de Contratações Públicas. Os dados disponibilizados no formato CSV também podem ser filtrados e consultados na própria tela deste site.</p>\n<p><em>Endpoints:<br /></em><a href=\"https://dadosabertos.almg.gov.br/api/ajuda/swagger/view/lastest#/paths/api-v2-contratacoes-pesquisa/get\">https://dadosabertos.almg.gov.br/api/ajuda/swagger/view/lastest#/paths/api-v2-contratacoes-pesquisa/get</a><br /><a href=\"https://dadosabertos.almg.gov.br/api/ajuda/swagger/view/lastest#/paths/api-v2-contratos-pesquisa-contratos/get\">https://dadosabertos.almg.gov.br/api/ajuda/swagger/view/lastest#/paths/api-v2-contratos-pesquisa-contratos/get</a><br /><a href=\"https://dadosabertos.almg.gov.br/api/ajuda/swagger/view/lastest#/paths/api-v2-contratos-pesquisa-convenios/get\">https://dadosabertos.almg.gov.br/api/ajuda/swagger/view/lastest#/paths/api-v2-contratos-pesquisa-convenios/get</a><br /><a href=\"https://dadosabertos.almg.gov.br/api/ajuda/swagger/view/lastest#/paths/api-v2-contratos-pesquisa-atas/get\">https://dadosabertos.almg.gov.br/api/ajuda/swagger/view/lastest#/paths/api-v2-contratos-pesquisa-atas/get</a><br /><br />Novos arquivos no formato CSV:<br /><a href=\"https://dadosabertos.almg.gov.br/documentacao/arquivos/atas-de-registro-de-precos\">https://dadosabertos.almg.gov.br/documentacao/arquivos/atas-de-registro-de-precos</a><br /><a href=\"https://dadosabertos.almg.gov.br/documentacao/arquivos/atas-de-registro-de-precos\">https://dadosabertos.almg.gov.br/documentacao/arquivos/contratos</a><br /><a href=\"https://dadosabertos.almg.gov.br/documentacao/arquivos/atas-de-registro-de-precos\">https://dadosabertos.almg.gov.br/documentacao/arquivos/convenios</a><br /><a href=\"https://dadosabertos.almg.gov.br/documentacao/arquivos/atas-de-registro-de-precos\">https://dadosabertos.almg.gov.br/documentacao/arquivos/contratacoes</a><br /><em><br /></em></p>\n<p><em>Data de publicação: 28/04/2026</em></p></dd>\n                            <dt class=\"text-info\">Novos campos para reunião e resultado de reunião de comissão e histórico de membro de comissão</dt>\n                        <dd class=\"small pb-3 mb-2\"><p>Reunião e resultado de reunião de comissão agora retornam as proposições em debate (campo <em>proposicoesEmDebate</em>). O histórico de membros de comissão (<em>MembroHistoricoComissao</em>) tem agora os campos para a data de início e término da participação do deputado na comissão, tanto para o titular, quanto para o suplente. </p>\n<p><em>Exemplos:</em><br /><a href=\"https://dadosabertos.almg.gov.br/api/v2/comissoes/1/reunioes/2/2013/04/11/09:30\">https://dadosabertos.almg.gov.br/api/v2/comissoes/1/reunioes/2/2013/04/11/09:30</a><br /><a href=\"https://dadosabertos.almg.gov.br/api/v2/comissoes/1270/composicoes/2025/05/06\">https://dadosabertos.almg.gov.br/api/v2/comissoes/1270/composicoes/2025/05/06</a></p>\n<p><em>Data de publicação: 28/04/2026</em></p></dd>\n                            <dt class=\"text-info\">Novos campos para o CSV de Legislação Mineira</dt>\n                        <dd class=\"small pb-3 mb-2\"><p>Foram incluídos os campos Situacao, NormaBasica e Indexacao ao arquivo CSV para a Legislação Mineira. Para mais informações, consulte a documentação em <a title=\"Legislação Mineira\" href=\"https://dadosabertos.almg.gov.br/documentacao/arquivos/legislacao-mineira\">Legislação Mineira</a>. </p>\n<p><em>Data de publicação: 17/03/2026</em></p></dd>\n                            <dt class=\"text-info\">Versão antiga da API descontinuada</dt>\n                        <dd class=\"small pb-3 mb-2\"><p>A versão antiga da API foi <strong>descontinuada</strong>. Lembrando, a versão atual deste site traz chamadas e formatos de resposta <strong>compatíveis</strong> com a versão anterior. Todos os <em>endpoints</em> (inclusive parâmetros - <em>queryparams - </em> e resultados), e suas categorias, foram preservados. </p>\n<p><a title=\"Fale com a Assembleia\" href=\"https://www.almg.gov.br/apps/fale-com/assembleia\">Fale com a Assembleia</a> para dúvidas e sugestões.</p>\n<p><em>Data de publicação: 05/06/2025</em></p></dd>\n                            <dt class=\"text-info\">Teste a nova versão da API</dt>\n                        <dd class=\"small pb-3 mb-2\"><p>A versão antiga da API (<a title=\"Acessar ajuda da versão obsoleta\" href=\"https://dadosabertos.almg.gov.br/ws/ajuda/sobre\">consulte documentação</a>) será <strong>descontinuada</strong> após<strong> 5/6/25</strong>. Em geral, a nova versão deste site traz chamadas e formatos de resposta <strong>compatíveis</strong> com a versão anterior.</p>\n<p>Todos os <em>endpoints</em> (inclusive parâmetros - <em>queryparams - </em> e resultados), e suas categorias, foram preservados. Ex: <br />Nova versão - <a style=\"word-break: break-all;\" href=\"https://dadosabertosn.almg.gov.br/api/v2/pronunciamentos/tipos\" target=\"_blank\" rel=\"noopener\">https://dadosabertos.almg.gov.br/api/v2/pronunciamentos/tipos</a>.<br />Versão anterior -<a style=\"word-break: break-all;\" href=\"https://dadosabertos.almg.gov.br/ws/pronunciamentos/tipos\" target=\"_blank\" rel=\"noopener\">https://dadosabertos.almg.gov.br/ws/pronunciamentos/tipos</a>.</p>\n<p>Como há pequenas diferenças<strong> </strong>no formato do XML ou do JSon retornado, é importante <strong>testar</strong> a nova versão. A regra geral é trocar  <code>\"/ws\"</code> para <code>\"/api/v2\"</code>  no link do <em>endpoint</em> utilizado. </p>\n<p><a title=\"Fale com a Assembleia\" href=\"https://www.almg.gov.br/apps/fale-com/assembleia\">Fale com a Assembleia</a> para dúvidas ou avisos sobre indisponibilidade programada e novas versões.</p>\n<p><em>Data de publicação: 17/02/2025</em></p></dd>\n                            <dt class=\"text-info\">Novo site: confira as novidades </dt>\n                        <dd class=\"small pb-3 mb-2\"><p>A nova versão (2.0) do site de Dados Abertos da Assembleia de Minas traz mais assuntos e diferentes tecnologias.</p>\n<ul>\n<li><strong>Interface </strong>web padronizada e responsiva</li>\n<li><strong>Novas consulta</strong>s (como contratações e Diário do Legislativo)</li>\n<li>Máxima <strong>preservação dos formatos</strong> de chamadas e de respostas na API nova com relação à API antiga</li>\n<li><strong>Revisão da documentação</strong> sobre a API</li>\n<li>Inclusão de <strong>arquivos</strong> <strong>CSV</strong> para temas importantes (como legislação, projetos de lei e verbas indenizatórias)</li>\n</ul>\n<p>Para mais detalhes, veja também a notícia <a title=\"Assembleia aprimora plataforma de dados abertos\" href=\"https://www.almg.gov.br/comunicacao/noticias/arquivos/Assembleia-aprimora-plataforma-de-dados-abertos/\">Assembleia aprimora plataforma de dados abertos</a>.</p>\n<p><em>Data de publicação: 17/02/2025</em></p></dd>\n                    </dl>\n            </div>\n        </div>\n    </div>\n                    </div>\n                </main>\n           </div>\n        </div>\n        <footer class=\"mt-5\">\n        \t<div class=\"pt-3 bg-primary text-white position-relative d-print-none pt-3\">\n        \t<div class=\"container pb-7\">\n        \t\t<div class=\"row justify-content-md-between align-items-center\">\n        \t\t    <div class=\"col-12 text-center text-light pb-3\">\n                         Assembleia Legislativa do Estado de Minas Gerais\n                         <br/>\n                         Todos os direitos reservados.\n                    </div>\n        \t\t\t<div class=\"col-12 col-lg-4 d-flex justify-content-center justify-content-md-left p-0 mb-3 mb-md-0\">\n        \t\t\t\t<div class=\"d-flex\">\n        \t\t\t\t\t<!--Icon-->\n        \t\t\t\t\t<div class=\"me-4 flex-shrink-0 position-relative d-none d-lg-block\">\n        \t\t\t\t\t\t<i class=\"bi bi-geo-alt-fill fs-3 lh-1 text-light position-relative\"></i>\n        \t\t\t\t\t</div>\n        \t\t\t\t\t<div class=\"flex-grow-1 text-center text-lg-start\">\n        \t\t\t\t\t\t<!--Description-->\n        \t\t\t\t\t\t<p class=\"mb-0 text-light small mb-2\">\n        \t\t\t\t\t\t\tRua Rodrigues Caldas, 30 | Santo Agostinho<br>\n        \t\t\t\t\t\t\tCEP 30190-921 | Belo Horizonte/MG<br>\n        \t\t\t\t\t\t\t(31) 2108-7000\n        \t\t\t\t\t\t</p>\n        \t\t\t\t\t</div>\n        \t\t\t\t</div>\n        \t\t\t</div>\n        \t\t\t<div class=\"col-lg-8 d-flex justify-content-end p-0 mb-3 mb-lg-0 mt-4 mt-lg-0 lh-sm text-end\">\n        \t\t\t    <div class=\"d-flex justify-content-end p-0 mb-3 mb-lg-0 mt-4 mt-lg-0 lh-sm align-items-center pe-4 border-end\">\n                            <a href=\"http://www.youtube.com/assembleiamg/\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1 bg-white\"><i class=\"text-primary lh-base fs-4 bx bxl-youtube\"></i></a>\n                            <a href=\"https://instagram.com/assembleiademinas/\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1 bg-white\"><i class=\"text-primary lh-base fs-4 bx bxl-instagram-alt\"></i></a>\n                            <a href=\"https://www.tiktok.com/@assembleiademinas\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1 bg-white\"><i class=\"text-primary lh-base fs-5 bi bi-tiktok\"></i></a>\n                            <a href=\"https://twitter.com/assembleiamg/\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1 bg-white\"><i class=\"text-primary lh-base fs-6 bi bi-twitter-x\"></i></a>\n                            <a href=\"https://www.facebook.com/assembleiademinas\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1 bg-white\"><i class=\"text-primary lh-base fs-4 bx bxl-facebook\"></i></a>\n                            <a href=\"https://www.threads.net/@assembleiademinas\" class=\"rounded-circle hover-lift width-3x height-3x align-middle d-flex align-items-center justify-content-center mx-1 bg-white\"><i class=\"text-primary lh-base fs-5 bi bi-threads\"></i></a>\n                        </div>\n          \t\t\t        <a href=\"https://www.almg.gov.br\" class=\" d-none d-xl-block d-xxl-block ps-4\"><img alt=\"Logomarca ALMG\" fetchpriority=\"high\" src=\"https://www.almg.gov.br/system/modules/br.gov.almg.site.commons/resources/imagens/logo-almg-white.svg\" style=\"height: 50px; width: auto;\"></a>\n        \t\t\t</div>\n        \t\t\t<div class=\"col-12 d-block d-lg-none text-center\">\n        \t\t\t\t<hr class=\"my-3 m-0\">\n        \t\t\t\t<ul class=\"nav flex-column flex-lg-column mb-0 lh-1\">\n        \t\t\t\t\t<li class=\"nav-item small\"><a class=\"nav-link link-hover-underline pb-0 px-0\"\n        \t\t\t\t\thref=\"/portal-da-almg/termos-de-uso-e-politica-de-privacidade/\">Termos de Uso e Política de Privacidade</a></li>\n        \t\t\t\t</ul>\n        \t\t\t</div>\n                    <div class=\"col-12 text-center text-light small \">\n                        <p>Versão: 2.4. </p>\n                    </div>\n        \t\t</div>\n        \t</div>\n        </div>\n        </footer>\n        </div>\n        <script>\n            // Function to toggle dropdown\n            function toggleDropdown(dropdown) {\n                const dropdownMenu = dropdown.querySelector('.dropdown-menu');\n                dropdownMenu.classList.toggle('show');\n            }\n\n            // Close dropdowns when clicking outside\n            document.addEventListener('click', function(event) {\n                const dropdowns = document.querySelectorAll('.dropdown');\n                dropdowns.forEach(function(dropdown) {\n                    if (!dropdown.contains(event.target)) {\n                        const dd = dropdown.querySelector('.dropdown-menu');\n                        if (dd){\n                            dd.classList.remove('show');\n                        }\n                    }\n                });\n            });\n\n            // Prevent dropdown from closing when clicking inside it\n            document.addEventListener('click', function(event) {\n                if (event.target.matches('.dropdown-menu') || event.target.closest('.dropdown-menu')) {\n                    event.stopPropagation();\n                }\n            });\n\n            // Add click event listeners to dropdown toggles\n            document.addEventListener('DOMContentLoaded', function() {\n                const dropdownToggles = document.querySelectorAll('.dropdown-toggle');\n                dropdownToggles.forEach(function(toggle) {\n                    toggle.addEventListener('click', function(event) {\n                        event.preventDefault();\n                        const dropdown = this.closest('.dropdown');\n                        toggleDropdown(dropdown);\n                    });\n                });\n            });\n        </script>\n        <script>\n                 function getCurrentServerURL() {\n                   // Get the current protocol (http or https)\n                   const protocol = window.location.protocol;\n\n                   // Get the hostname (server name)\n                   const hostname = window.location.hostname;\n\n                   // Get the port number (if applicable)\n                   const port = window.location.port;\n\n                   // Construct the URL string\n                   let url = protocol + '//' + hostname;\n\n                   // Append the port if it's non-standard (not 80 for http or 443 for https)\n                   if (port && port !== '80' && port !== '443') {\n                     url += ':' + port;\n                   }\n\n                   return url + '/';\n                 }\n\n                    document.addEventListener('DOMContentLoaded', function() {\n                        // Select all anchor tags\n                        const anchors = document.getElementsByTagName('a');\n\n                        // Convert to array and filter for relevant hrefs\n                        const relevantAnchors = Array.from(anchors).filter(anchor =>\n                            anchor.href.startsWith('http://dados-abertos/')\n                        );\n\n                        // Remove the prefix from relevant hrefs\n                        relevantAnchors.forEach(anchor => {\n                            anchor.href = anchor.href.replace('http://dados-abertos/', getCurrentServerURL());\n                        });\n                    });\n             </script>\n        <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js\"></script>\n    </body>\n</html>\n"
  }
