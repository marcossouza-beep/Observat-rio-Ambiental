  "corpo": {
    "html": "<!doctype html>\n<html lang=\"pt-br\">\n\n<head>\n    <meta charset=\"utf-8\">    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"title\" content=\"Documentos / PL./0639/2026 / Proposições / e-Legis / ALESC\">\n    <meta name=\"robots\" content=\"index, follow\">\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n    <meta name=\"language\" content=\"Portuguese\">\n    <meta name=\"revisit-after\" content=\"3 days\">\n    <meta name=\"author\" content=\"Assembleia Legislativa de Santa Catarina\">\n    <title>Documentos / PL./0639/2026 / Proposições / e-Legis / ALESC</title>\n    <meta name=\"csrfToken\" content=\"iR5N0ZnmPeOqrfYg1NWQhV+bfeDVY/Lye94BE1TSA9iTfu2CLM2F1cP3b+qdieY5++38BcRDxYUTz0AIJotdYIPP5VyfvthAaq8Y2LAGlJRI7DQlbesx7PdP2eZOqOSx98YN26qx0w7C2s828XCk5g==\">    <link href=\"/alesc/bootstrap_theme/favicon.ico?1788191743\" type=\"image/x-icon\" rel=\"icon\">    <script src=\"/alesc/bootstrap_theme/js/bootstrap.bundle.min.js?1788191743\"></script>    <script src=\"/alesc/bootstrap_theme/js/sweetalert2.js?1788191743\"></script>    <script src=\"/alesc/bootstrap_theme/js/theme.js?1788191743\"></script>    <script src=\"/alesc/bootstrap_theme/js/htmx.min.js?1788191743\"></script>    <link rel=\"stylesheet\" href=\"/alesc/bootstrap_theme/css/bootstrap.min.css?1788191743\">    <link rel=\"stylesheet\" href=\"/alesc/bootstrap_theme/css/fontawesome.min.css?1788191743\">    <link rel=\"stylesheet\" href=\"/alesc/bootstrap_theme/css/default.css?1788191743\">        <link rel=\"stylesheet\" href=\"/css/app.css?1784466504\">    <script defer=\"true\">\n                document.addEventListener(\"DOMContentLoaded\", () => {\n                    const offcanvasEl = document.getElementById(\"offcanvas-comissao\")\n                    const offcanvas =  new bootstrap.Offcanvas(offcanvasEl)\n                    const elements = document.querySelectorAll(\".btn-comissao\")\n                    Array.from(elements).map((element) => {\n                        element.addEventListener(\"click\", (event) => {\n                            event.preventDefault()\n                            const button = event.currentTarget\n                            const options = {\n                                headers: {\n                                    \"X-Requested-With\": \"XMLHttpRequest\"\n                                }\n                            }\n                            fetch(button.href, options)\n                                .then(response => response.text())\n                                .then((text) => {\n                                    offcanvasEl.querySelector(\".offcanvas-title\").innerHTML = button.dataset.title\n                                    offcanvasEl.querySelector(\".offcanvas-body\").innerHTML = text\n                                    offcanvas.show()\n                                })\n                        })\n                    })\n                })\n            </script><script defer=\"true\">\n                    document.addEventListener(\"DOMContentLoaded\", () => {\n                        const modalFullscreenEl = document.getElementById(\"modal-fullscreen-documento\")\n                        const modalDocumento = new bootstrap.Modal(modalFullscreenEl)\n                        document.querySelectorAll(\"a.btn-view-documento\").forEach((element) => {\n                            element.addEventListener(\"click\", (event) => {\n                                event.preventDefault()\n                                const element = event.currentTarget\n                                const url = element.href\n                                const options = {\n                                    method: \"GET\",\n                                    headers: new Headers({\n                                        \"X-Requested-With\": \"XMLHttpRequest\"\n                                    })\n                                }\n                                fetch(url, options)\n                                    .then(async (response) => {\n                                        if (response.ok) {\n                                            const html = await response.text()\n                                            modalFullscreenEl.querySelector(\".modal-title\").innerHTML = element.title\n                                            modalFullscreenEl.querySelector(\".modal-body\").innerHTML = html\n                                            modalDocumento.show()\n                                        } else {\n                                            Swal.fire({\n                                                title: \"Error\",\n                                                text: \"Erro ao carregar o documento.\",\n                                                icon: \"error\",\n                                                confirmButtonText: \"Fechar\"\n                                            })\n                                        }\n                                    })\n                            })\n                        })\n                    })\n                </script><script defer=\"true\">\n                document.addEventListener(\"DOMContentLoaded\", () => {\n                    document.querySelectorAll(\"a.btn-push\").forEach((element) => {\n                        element.addEventListener(\"click\", () => Swal.fire({\n                            title: \"Atenção\",\n                            text: \"O acompanhamento de proposições (PUSH) encontra-se indisponível temporariamente devido à implantação do sistema de tramitação eletrônica.\",\n                            icon: \"warning\",\n                            confirmButtonText: \"Fechar\"\n                        }))\n                    })\n                })\n            </script><script defer=\"true\">\n                document.addEventListener(\"DOMContentLoaded\", () => {\n                    const modalBodySelector = \"#modal-reuniao-processo .modal-body\";\n                    const loader = `<div class=\"d-flex justify-content-center py-5\"><div class=\"spinner-border text-primary\" role=\"status\"><span class=\"visually-hidden\">Carregando...</span></div></div>`;\n                    document.body.addEventListener(\"htmx:beforeRequest\", (event) => {\n                        if (!event.detail.elt.matches(\".btn-extrato-votacao\")) {\n                            return;\n                        }\n                        const body = document.querySelector(modalBodySelector);\n                        if (body) {\n                            body.innerHTML = loader;\n                        }\n                    });\n                    document.body.addEventListener(\"htmx:responseError\", (event) => {\n                        if (!event.detail.elt.matches(\".btn-extrato-votacao\")) {\n                            return;\n                        }\n                        const body = document.querySelector(modalBodySelector);\n                        if (body) {\n                            body.innerHTML = `<div class=\"alert alert-danger m-3\" role=\"alert\">Erro ao carregar o extrato de votação.</div>`;\n                        }\n                    });\n                });\n            </script><script src=\"/js/htmx.min.js?1784466504\"></script><script src=\"/js/htmx/ajax-header.js?1784466504\"></script><script src=\"/js/dayjs.min.js?1784466504\"></script>    <!-- Google tag (gtag.js) -->\n    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-E3XEDD98K8\"></script>\n    <script>\n        window.dataLayer = window.dataLayer || [];\n\n        function gtag() {\n            dataLayer.push(arguments);\n        }\n        gtag('js', new Date());\n        gtag('config', 'G-E3XEDD98K8');\n    </script>\n    <script>\n\n    </script>\n</head>\n\n<body>\n    <nav class=\"navbar navbar-expand-lg bg-whi