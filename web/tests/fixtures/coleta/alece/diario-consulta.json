iv class=\"collapse navbar-collapse barra-navegacao mx-auto justify-content-center mt-2\" id=\"navbarNav\">\n            \n            \n            \n            \n            \n            <ul class=\"navbar-nav publico\" hidden>\n                <li class=\"nav-item\">\n    <a class=\"text-white nav-link\" style=\"font-size: 16px;\">\n        <i class=\"fas fa-newspaper\"></i>&nbsp;Diário da Assembleia\n    </a>\n</li>\n\n\n            </ul>\n\n                    </div>\n\n        <div class=\"col-2\" id=\"drop\" hidden></div>\n\n        <div class=\"dropdown mt-2\" style=\"cursor: pointer; margin-right: 30px;\">\n            <div\n                class=\"d-flex flex-row\"\n                id=\"dropdownMenuButton\"\n                data-toggle=\"dropdown\"\n                aria-expanded=\"false\"\n            >\n                <div class=\"d-flex align-items-center mr-3 text-white\">\n                    <i class=\"fas fa-user\"></i>\n                </div>\n\n                <div class=\"d-flex flex-column\" style=\"font-size: 1.7vh;\">\n                    <span class=\"nome-usuario text-white font-weight-bold dropdown-toggle\"></span>\n                    <small class=\"email-usuario text-white\"></small>\n                </div>\n\n                <div class=\"dropdown-menu\" aria-labelledby=\"dropdownMenuButton\">\n                    <div class=\"opcoes\"></div>\n\n                    <hr class=\"divisor-dropdown\">\n\n                    <button\n                        onclick=\"logout()\"\n                        class=\"dropdown-item\"\n                    >Sair do Sistema</button>\n                </div>\n            </div>\n        </div>\n    </nav>\n</header>\n\n<div class=\"espacamento-mobile\"><br><br><br></div>\n\n    \n        <section class=\"pagina p-3\">\n        <div class=\"container py-4\">\n        <div class=\"row\">\n            \n            <div style=\"margin: 0;\" class=\"col-md-12 conteudo-cabecalho\"></div>\n\n            <div class=\"col-md-12 mt-3\">\n                <h6>\n                    <strong>Diário Oficial da Assembleia Legislativa do Estado do Ceará</strong>\n                </h6>\n                <p style=\"font-size: 14px;\">\n                    O preenchimento dos campos <strong>Frase Exata</strong> bem como <strong>Período Inicial</strong> e <strong>Final</strong> é obrigatório na Consulta Avançada, e o intervalo entre as datas deve ser de, no máximo, um ano.\n                </p>\n            </div>\n\n            \n            <div class=\"col-md-12 mb-3\" id=\"form-simples\">\n                <div class=\"card\" style=\"border: 1px solid #ccc; border-radius: 6px;\">\n                    <div class=\"card-body\">\n                        <form id=\"form-consulta-simples\">\n                            <div class=\"row\">\n                                <div class=\"col-md-8 col-sm-12 mb-3\">\n                                    <label for=\"palavra_chave\" class=\"form-label\">\n                                        Palavra-chave\n                                        <span data-toggle=\"tooltip\" data-placement=\"top\" title=\"Busca por palavras no conteúdo das edições.\">ⓘ</span>\n                                    </label>\n                                    <input type=\"text\" class=\"form-control\" name=\"palavra_chave\" id=\"palavra_chave\" />\n                                </div>\n\n                                <div class=\"col-md-4 col-sm-12 mb-3\">\n                                    <label for=\"data_publicacao\" class=\"form-label\">Data da Publicação</label>\n                                    <input type=\"date\" class=\"form-control\" name=\"data_publicacao\" id=\"data_publicacao\" />\n                                </div>\n\n                                <div class=\"col-md-12 mb-3\">\n                                    <label for=\"titulo_materia_simples\" class=\"form-label\">Título da Matéria</label>\n                                    <input type=\"text\" class=\"form-control\" name=\"titulo_materia\" id=\"titulo_materia_simples\" />\n                                </div>\n\n                                <div class=\"col-md-6 col-sm-12 mb-3\">\n                                    <label for=\"secao_simples\" class=\"form-label\">Seção</label>\n                                    <select class=\"form-control\" name=\"secao\" id=\"secao_simples\"></select>\n                                </div>\n\n                                <div class=\"col-md-6 col-sm-12 mb-3\">\n                                    <label for=\"tipo_materia_simples\" class=\"form-label\">Tipo de Matéria</label>\n                                    <select class=\"form-control\" name=\"tipo_materia\" id=\"tipo_materia_simples\" disabled>\n                                        <option value=\"\">Selecione um tipo de Matéria</option>\n                                    </select>\n                                </div>\n\n                                <div class=\"col-md-12\">\n                                    <div class=\"d-flex justify-content-between align-items-center\">\n                                        <div>\n                                            <button type=\"submit\" class=\"btn btn-primary-do\">\n                                                <i class=\"fa fa-search mr-1\"></i> Consultar\n                                            </button>\n                                            <button type=\"reset\" class=\"btn btn-primary-do ml-2\" id=\"limpar-simples\">\n                                                Limpar\n                                            </button>\n                                        </div>\n                                        <button type=\"button\" class=\"btn btn-primary-do\" onclick=\"toggleModo('avancada')\">\n                                            Consulta Avançada &gt;&gt;\n                                        </button>\n                                    </div>\n                                </div>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"col-md-12 mb-3\" id=\"form-avancada\" style=\"display: none;\">\n                <div class=\"card\" style=\"border: 1px solid #ccc; border-radius: 6px;\">\n                    <div class=\"card-body\">\n                        <form id=\"form-consulta-avancada\">\n                            <div class=\"row\">\n                                <div class=\"col-md-4 col-sm-12 mb-3\">\n                                    <label for=\"frase_exata\" class=\"form-label\">\n                                        Frase Exata *\n                                        <span data-toggle=\"tooltip\" data-placement=\"top\" title=\"Busca pela frase exata no conteúdo das edições. Mínimo 3 caracteres.\">ⓘ</span>\n                                    </label>\n                                    <input type=\"text\" class=\"form-control\" name=\"frase_exata\" id=\"frase_exata\" />\n                                </div>\n\n                                <div class=\"col-md-4 col-sm-12 mb-3\">\n                                    <label for=\"periodo_inicial\" class=\"form-label\">Período Inicial *</label>\n                                    <input type=\"date\" class=\"form-control\" name=\"periodo_inicial\" id=\"periodo_inicial\" />\n                                </div>\n\n                                <div class=\"col-md-4 col-sm-12 mb-3\">\n                                    <label for=\"periodo_final\" class=\"form-label\">Período Final *</label>\n                                    <input type=\"date\" class=\"form-control\" name=\"periodo_final\" id=\"periodo_final\" />\n                                </div>\n\n                                <div class=\"col-md-4 col-sm-12 mb-3\">\n                                    <label for=\"ano_publicacao\" class=\"form-label\">Ano da Publicação</label>\n                                    <input type=\"number\" class=\"form-control\" name=\"ano_publicacao\" id=\"ano_publicacao\" min=\"0\" />\n                                </div>\n\n                                <div class=\"col-md-4 col-sm-12 mb-3\">\n                                    <label for=\"numero_publicacao\" class=\"form-label\">Número da Publicação</label>\n                                    <input type=\"text\" class=\"form-control\" name=\"numero_publicacao\" id=\"numero_publicacao\" />\n                                </div>\n\n                                <div class=\"col-md-4 col-sm-12 mb-3\">\n                                    <label for=\"titulo_materia_avancada\" class=\"form-label\">Título da Matéria</label>\n                                    <input type=\"text\" class=\"form-control\" name=\"titulo_materia\" id=\"titulo_materia_avancada\" />\n                                </div>\n\n                                <div class=\"col-md-6 col-sm-12 mb-3\">\n                                    <label for=\"secao_avancada\" class=\"form-label\">Seção</label>\n                                    <select class=\"form-control\" name=\"secao\" id=\"secao_avancada\"></select>\n                                </div>\n\n                                <div class=\"col-md-6 col-sm-12 mb-3\">\n                                    <label for=\"tipo_materia_avancada\" class=\"form-label\">Tipo de Matéria</label>\n                                    <select class=\"form-control\" name=\"tipo_materia\" id=\"tipo_materia_avancada\" disabled>\n                                        <option value=\"\">Selecione um tipo de Matéria</option>\n                                    </select>\n                                </div>\n\n                                <div class=\"col-md-12\">\n                                    <div class=\"d-flex justify-content-between align-items-center\">\n                                        <div>\n                                            <button type=\"submit\" class=\"btn btn-primary-do\">\n                                                <i class=\"fa fa-search mr-1\"></i> Consultar\n                                            </button>\n                                            <button type=\"reset\" class=\"btn btn-primary-do ml-2\" id=\"limpar-avancada\">\n                                                Limpar\n                                            </button>\n                                        </div>\n                                        <button type=\"button\" class=\"btn btn-primary-do\" onclick=\"toggleModo('simples')\">\n                                            Consulta Simples &gt;&gt;\n                                        </button>\n                                    </div>\n                                </div>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"col-lg-12 col-md-12 col-sm-12 mt-4\" id=\"container-tabela\" style=\"display: none;\">\n                <div id=\"tabela-edicoes\"></div>\n            </div>\n\n            \n            <div class=\"col-md-12 mt-4\">\n                <h6><strong>Informações Gerais</strong></h6>\n                <div id=\"rodape-consulta\"></div>\n            </div>\n        </div>\n\n        <div\n    class=\"modal fade\"\n    id=\"modal-arquivo\"\n    tabindex=\"-1\"\n    role=\"dialog\"\n    data-backdrop=\"static\"\n    aria-hidden=\"true\"\n>\n    <div\n        class=\"modal-dialog modal-lg\"\n        role=\"document\"\n    >\n        <div class=\"modal-content\">\n            <div class=\"modal-header\">\n                <h5 class=\"modal-title\" id=\"titulo-modal\">Visualizar Documento:</h5>\n                <button\n                    type=\"button\"\n                    class=\"close\"\n      