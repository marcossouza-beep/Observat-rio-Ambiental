                <tr>\n                                <td>Data da Assinatura:</td>\n                                <td id=\"edicao-data-assinatura\"></td>\n                            </tr>\n                            <tr>\n                                <td>Autoridade Certificadora:</td>\n                                <td id=\"edicao-autoridade-certificadora\"></td>\n                            </tr>\n                            <tr>\n                                <td>Integridade:</td>\n                                <td><i class=\"fa fa-check-circle\" style=\"color: #49844a;\"></i> Documento não foi modificado desde que esta assinatura foi aplicada</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n        </div>\n    </section>\n\n    \n    <script\n        type=\"text/javascript\"\n        src=\"https://doalece.al.ce.gov.br/plugins/fontawesome/fontawesome-all.js\"\n        data-auto-replace-svg=\"nest\"\n    ></script>\n\n    \n    <script\n        type=\"text/javascript\"\n        src=\"https://doalece.al.ce.gov.br/plugins/jquery/jquery-3.6.0.min.js\"\n    ></script>\n\n    \n    <script\n        type=\"text/javascript\"\n        src=\"https://doalece.al.ce.gov.br/plugins/jquery-ui/js/jquery-ui.min.js\"\n    ></script>\n    <script\n        src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery.blockUI/2.70/jquery.blockUI.min.js\"\n        integrity=\"sha384-Ct2s0NBxEbvJlnXHOZJheqOGKjX3Q4ewsYoJZYnLz/teMXnlGhim5o9305EkvlsN\"\n        crossorigin=\"anonymous\"\n    ></script>\n\n    \n    <script\n        type=\"text/javascript\"\n        src=\"https://doalece.al.ce.gov.br/plugins/jquery-mask/jquery.mask.min.js\"\n    ></script>\n\n    \n    <script\n        type=\"text/javascript\"\n        src=\"https://doalece.al.ce.gov.br/plugins/bootstrap/js/popper.min.js\"\n    ></script>\n    <script\n        type=\"text/javascript\"\n 